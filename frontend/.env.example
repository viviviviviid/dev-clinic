# 배포자/프론트엔드 개발자 전용. 일반 사용자는 만들 필요가 없습니다.
# legacy anon 키도 지원합니다. service_role/secret 키는 넣지 마세요.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_public_key

# 로컬 clinic URL (미지정 시 http://127.0.0.1:47291)
# Vercel CSP는 127.0.0.1/localhost의 명시적 포트를 허용합니다. 포트를 바꾸려면
# config.toml의 [server].port와 VITE_LOCAL_URL만 같은 값으로 맞추세요.
# VITE_LOCAL_URL=http://127.0.0.1:47291
