# 로컬 고급 설정 (선택사항 — 일반 사용자는 이 파일을 복사할 필요가 없습니다)
# ./run.sh ~/learning 만 실행하면 배포 사이트에서 공개 연결 정보를 가져옵니다.
# 관리자 키(service_role/secret)와 JWT 서명 비밀키는 clinic에서 사용하지 않습니다.
ai_provider = "codex"

[codex]
# GUI에서 PATH를 찾지 못하면 ~/.local/bin/codex도 자동 확인합니다.
executable = "codex"
# 비우면 Codex CLI의 현재 기본 모델을 사용합니다.
model = ""

[gemini]
# Gemini를 선택할 때만 개인 키가 필요합니다.
api_key = ""
model = "gemini-3.6-flash"

[server]
port = "47291"
