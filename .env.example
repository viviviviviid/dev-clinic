# 선택형 로컬 설정. 일반 사용자는 .env.local 없이 ./run.sh ~/learning을 실행합니다.
# 기본 배포 사이트에서 공개 Supabase 설정을 자동으로 읽습니다.
# 자체 배포자는 사이트 주소만 변경하면 HTTP/WS Origin도 함께 허용됩니다.
# CLINIC_SITE_URL=https://your-site.example

# 이 Mac에서 사용할 계정을 추가로 제한할 때만 지정하세요.
ALLOWED_USER_EMAILS=
ALLOWED_USER_IDS=

# 추가로 허용할 production origin (쉼표 구분)
ALLOWED_ORIGINS=

# 선택형 Codex CLI 모델 override
CODEX_MODEL=

# 개발자가 공개 설정을 직접 지정할 때만 두 값을 모두 설정합니다.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
