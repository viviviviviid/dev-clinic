# Copy this file to .env.local. run.sh loads it before starting clinic.
ALLOWED_USER_EMAILS=your-google-account@example.com

# Optional legacy UUID allowlist. Email and UUID allowlists use OR semantics.
ALLOWED_USER_IDS=

# tutor.abcfe.net is already allowed by default. Add custom production origins here.
ALLOWED_ORIGINS=

# Optional Codex CLI model override.
CODEX_MODEL=
